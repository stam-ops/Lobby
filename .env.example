# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=lobby_ws

# App
PORT=3000

# Auth : true = AuthGuard rejette en 401 les requêtes non authentifiées.
#        false/absent = mode log-only (warning sans blocage). Mettre true une fois
#        que toutes les versions d'app en circulation envoient le hash de session.
AUTH_ENFORCE=false

# JWT backoffice (signature des tokens admin). METTRE UNE VALEUR ALÉATOIRE LONGUE EN PROD.
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS : origines autorisées pour le backoffice navigateur (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,https://backoffice.campok.fr
