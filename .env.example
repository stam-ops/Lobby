# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=lobby_ws

# App
PORT=3000

# Auth : true = AuthGuard rejette en 401 les requêtes non authentifiées.
#        false/absent = mode log-only (warning sans blocage). Mettre true une fois
#        que toutes les versions d'app en circulation envoient le hash de session.
AUTH_ENFORCE=false

# JWT backoffice (signature des tokens admin). METTRE UNE VALEUR ALÉATOIRE LONGUE EN PROD.
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Supervision : un SipServer est "actif" si son heartbeat (lastts) date de moins de N secondes.
# Le code de load-balancing utilise 60 s (heartbeat ~30 s). Augmenter pour plus de tolérance.
SIP_ALIVE_SECONDS=60

# CORS : origines autorisées pour le backoffice navigateur (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,https://backoffice.campok.fr

# ─── Chance-o-mètre (module chance, base créée par sql/002_chance.sql) ───
# Clé partagée avec le serveur du Chance-o-mètre (32 caractères au moins) : sans elle, routes /chance fermées.
CHANCE_PARTNER_KEY=
# Base des comptes, à part de maindb.
CHANCE_DB=chance
# Empreintes des liens et codes envoyés par e-mail, et signature des sessions : deux valeurs aléatoires longues
# (32 caractères au moins), différentes entre elles et de JWT_SECRET. Sinon les comptes restent fermés (503).
CHANCE_TOKEN_SECRET=
CHANCE_SESSION_SECRET=
# Adresse publique du Chance-o-mètre (liens des e-mails : /compte/connexion, /compte/suppression).
CHANCE_PUBLIC_URL=https://chance.campok.app
# Liste de nouvelles chez Mailjet (API Contacts). Sans ces valeurs : rien n'est envoyé, journal seulement.
# Les e-mails de connexion passent par MailService (SMTP_HOST…, comme les organisateurs) : relais Mailjet SMTP_HOST=in-v3.mailjet.com, port 587,
# SMTP_USER = clé API, SMTP_PASSWORD = clé secrète.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_LIST_ID=
# Expéditeur des e-mails du Chance-o-mètre, avec le nom affiché (guillemets obligatoires) ; vide : MAIL_FROM.
# MAIL_FROM sert aux e-mails des organisateurs (club.campok.app), ex. MAIL_FROM="Campok <no-reply@domaine>".
CHANCE_MAIL_FROM="Chance-o-mètre <no-reply@domaine>"
# Captcha : le domaine du Chance-o-mètre doit être ajouté aux noms d'hôte du widget Turnstile (CAPTCHA_SECRET).
# Liaison au compte Campok (offre 2, table de sql/003_chance_link.sql) : le code part en notification interne
# (type 23) ; push Firebase en plus si ce chemin mène au compte de service (le même service.json que FrontWebCampok).
# Vide : pas de push, la notification interne suffit.
FIREBASE_SERVICE_ACCOUNT=
# Campok VIP vendu sur le Chance-o-mètre (chance/vip-web.service.ts) : clé secrète Stripe (sk_test_… en essai,
# sk_live_… en production) et secret du webhook https://<LobbyWS>/webhooks/stripe (whsec_…). Vides : vente fermée.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
